# Point the UI at the backend planner and spot extractor.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Gemini key for Loopie chat (server-only; never prefix with NEXT_PUBLIC_).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional dedicated key for place search; falls back to GEMINI_API_KEY when unset.
GEMINI_SEARCH_API_KEY=
# Set to true when GEMINI_SEARCH_API_KEY is a Vertex AI key (Google Cloud credits).
GEMINI_SEARCH_VERTEX=
# Optional: override the model
# GEMINI_MODEL=gemini-3.8-flash   (smarter, but only ~20 free requests/day)

# Supabase public project credentials (never put a service-role key here).
# Leave unset to use the built-in demo spots.
NEXT_PUBLIC_SUPABASE_URL=https://qywxkisuiykdwudhyybq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Optional; defaults to "places".
NEXT_PUBLIC_SUPABASE_LOCATIONS_TABLE=places

# ElevenLabs key for Loopie's voice (server-only; never prefix with NEXT_PUBLIC_).
# Get one at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Optional: another voice (default "Jessica") or model (default eleven_flash_v2_5)
# ELEVENLABS_VOICE_ID=cgSgspJ2msm6clMCkdW9
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5
