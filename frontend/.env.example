# Point the UI at the backend planner. Leave unset to use demo data.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Gemini key for Loopie chat (server-only; never prefix with NEXT_PUBLIC_).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the model
# GEMINI_MODEL=gemini-3.8-flash
