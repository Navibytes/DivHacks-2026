PORT=4000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
SUPABASE_PLACES_TABLE=places
SUPABASE_UNPINNED_TABLE=unpinned
GEMINI_API_KEY=your-gemini-api-key
# Optional; defaults to gemini-3.5-flash-lite
GEMINI_VIDEO_MODEL=gemini-3.5-flash-lite
# Recommended: Google Places API (New) key for accurate venue coordinates.
# Restrict it to "Places API (New)" in Google Cloud. Without it, lookups use
# OpenStreetMap Nominatim (free, but weaker at venue names and chains).
GOOGLE_PLACES_API_KEY=
# Fallback address lookup provider endpoint; no API key required.
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
NOMINATIM_USER_AGENT=LocalLoop/0.1 (https://github.com/Navibytes/DivHacks-2026)
